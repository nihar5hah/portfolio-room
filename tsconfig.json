{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "desktop/src"
  ],
  "exclude": [
    "desktop/src/reportWebVitals.ts"
  ]
}